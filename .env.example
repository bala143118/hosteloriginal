TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service_role key only on the Node.js server. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional shared secret for Python surveillance -> Node.js security event ingestion.
SECURITY_EVENT_INGEST_TOKEN=replace-with-a-long-random-secret
SURVEILLANCE_API_URL=http://localhost:5000
SURVEILLANCE_API_KEY=replace-with-a-long-random-secret
WARDEN_WEBHOOK_URL=
SURVEILLANCE_CONFIRMATION_FRAMES=5
SURVEILLANCE_COOLDOWN_SECONDS=30
SURVEILLANCE_MINIMUM_PRESENCE_SECONDS=60
# Email Service Configuration (Required for verification code / OTP emails)
# Option 1: Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
EMAIL_FROM="Sri Shakthi HostelFix" <your-email@gmail.com>

# Option 2: Resend API (Alternative to SMTP)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=HostelFix
DB_USER=postgres
DB_PASSWORD=your-postgres-password

# Cryptographic Token & Authentication Secrets
JWT_SECRET=your-secure-jwt-secret-min-32-chars
GATEPASS_JWT_SECRET=your-secure-gatepass-jwt-secret

